# Build output
bin/
obj/
.vs/
*.user

# AI assistant local state (machine-specific; never shared)
.claude/settings.local.json
.codemie/

# Reqnroll-generated code-behind for .feature files (regenerated on every build)
*.feature.cs

# Everything a run produces: TUnit report/TRX, Reqnroll report, Playwright traces (see Core/ArtifactPaths.cs)
TestResults/

# Local configuration and credentials: never committed. Copy .env.example to .env.
.env


# =====================================================================
# Додатково
# =====================================================================

# Усі локальні варіанти .env, крім шаблону (.env.example має лишатися в git)
.env.*
!.env.example

# Конфіг Report Portal (містить API-токен) - ніколи не комітити, у CI задавати секретами
ReportPortal.json
reportportal.json
ReportPortal.config.json

# Артефакти запусків, якщо ARTIFACTS_DIR вказує всередину репозиторію
/artifacts/
allure-results/
allure-report/
playwright-report/
blob-report/
traces/
videos/
screenshots/

# Покриття коду
coverage/
*.coverage
*.cobertura.xml

# Локальні файли IDE (Rider / VS)
.idea/
*.DotSettings.user
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Логи й системні файли
*.log
.DS_Store
Thumbs.db
