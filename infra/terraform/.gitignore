# =====================================================================
# Terraform
# =====================================================================

# Локальна робоча тека (завантажені провайдери, кеш backend)
.terraform/

# State-файли: містять ID ресурсів і можуть містити секрети.
# Справжній state лежить у S3 (див. backend.tf) - у git йому не місце.
*.tfstate
*.tfstate.*

# Лог аварійного завершення
crash.log
crash.*.log

# Файли зі змінними: містять особисті дані (наприклад, alert_emails).
# Для прикладу створіть terraform.tfvars.example - його ці патерни не зачеплять.
*.tfvars
*.tfvars.json

# Збережені плани та їхній вивід
*.tfplan
tfplan
plan.out
plan.json

# Локальні перевизначення конфігурації
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Локальний CLI-конфіг
.terraformrc
terraform.rc

# ВАЖЛИВО: файл .terraform.lock.hcl НЕ ігнорується - його потрібно комітити,
# щоб у всіх (і в CI) були однакові версії провайдерів.

# =====================================================================
# Секрети та локальні дампи
# =====================================================================
.env
.env.*
*.pem
*.key
.aws/
out.json
response.json
